# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth apps (create at console.cloud.google.com and github.com/settings/developers)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Shared secret with the Go server (server/.env API_JWT_SECRET)
API_JWT_SECRET=dev-secret-change-me

# Go backend base URL (local: http://localhost:8080, prod: your Render URL)
BACKEND_URL=http://localhost:8080
