# Local dev: postgres from docker-compose (make db-up)
DATABASE_URL=postgres://cloudair:cloudair@localhost:5433/cloudair?sslmode=disable

# Shared secret with web/.env.local API_JWT_SECRET (any long random string)
API_JWT_SECRET=dev-secret-change-me

# Guards POST /internal/recrawl
INTERNAL_TOKEN=dev-internal-token

# Optional — leave empty to use the non-LLM llms.txt fallback
GEMINI_API_KEY=
# Note: older models (gemini-2.0-flash, 2.5 family) have no free-tier quota
# for new keys anymore — use a current lite/flash model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Externally reachable base URL (used in llms.txt links and MCP URLs)
PUBLIC_BASE_URL=http://localhost:8080

# Optional: enables Host-header site resolution, e.g. ".cloudair.dev"
HOST_SUFFIX=

PORT=8080
