{
  "name": "cloudair-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && cp -R src/db/migrations dist/db/migrations && cp src/signatures.json dist/signatures.json",
    "migrate": "tsx src/index.ts --migrate-only",
    "seed": "tsx src/index.ts --seed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:create": "node-pg-migrate create -m src/db/migrations -j sql"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@mozilla/readability": "^0.5.0",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.0",
    "jsdom": "^24.1.3",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.4.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "robots-parser": "^3.0.1",
    "tldts": "^6.1.60",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
