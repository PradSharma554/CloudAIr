{
  "name": "cloudair-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && cp -R src/db/migrations dist/db/migrations && cp src/signatures.json dist/signatures.json",
    "migrate": "tsx src/index.ts --migrate-only",
    "seed": "tsx src/index.ts --seed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:create": "node-pg-migrate create -m src/db/migrations -j sql"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.3",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "robots-parser": "^3.0.1",
    "tldts": "^7.4.19",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
